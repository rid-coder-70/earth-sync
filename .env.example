# Get a free key at https://firms.modaps.eosdis.nasa.gov/api/
# Keep this value on the server only. Never add it to client/.env.
FIRMS_MAP_KEY=
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/earth-sync.sqlite
# Harmonization / activity tuning
CLUSTER_RADIUS_METERS=750
UNUSUAL_Z_SCORE=2
